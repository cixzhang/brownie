{
  "name": "brownie",
  "version": "0.1.0",
  "description": "A native web component library",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ssr": "./src/ssr.js",
    "./ssr/hydrate": "./src/hydrate.js",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "test": "web-test-runner tests/**/*.test.js --node-resolve",
    "test:watch": "web-test-runner tests/**/*.test.js --node-resolve --watch",
    "typecheck": "tsc"
  },
  "keywords": [
    "web-components",
    "custom-elements"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4",
    "@web/test-runner": "^0.18.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3"
  }
}
